---
import { useTranslations, getProcessLabels } from '../i18n/ui';
import type { Locale } from '../i18n/languages';
import { Image } from 'astro:assets';
import atelierPhoto from '../assets/photos/atelier-tablette-ar.jpg';
import production from '../assets/process/production.png';
import optimisation from '../assets/process/optimisation.png';
import cnc from '../assets/process/cnc.png';
import stocks from '../assets/process/stocks.png';
import achats from '../assets/process/achats.png';
import ia from '../assets/process/ia.png';
import planning from '../assets/process/planning.png';
import livraison from '../assets/process/livraison.png';
import modele3d from '../assets/process/3d.png';
import temps from '../assets/process/temps.png';
import qualite from '../assets/process/qualite.svg';
import finance from '../assets/process/finance.svg';

const locale = (Astro.currentLocale ?? 'fr') as Locale;
const t = useTranslations(locale);
const labels = getProcessLabels(locale);

const icons = [production, optimisation, cnc, stocks, achats, ia, planning, livraison, modele3d, temps, qualite, finance];
const solutions = labels.map((label, i) => ({ icon: icons[i], label }));
---

<section id="processus" class="process-section process-section--gradient section-anchor-line section-spacing">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-9" data-aos="fade-up">
      <span class="text-primary text-base font-semibold tracking-wider uppercase">
        {t('process.badge')}
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-dark mt-2 mb-3">
        {t('process.heading')}
      </h2>
      <p class="text-text-light text-lg max-w-2xl mx-auto">
        {t('process.description')}
      </p>
    </div>

    <div class="process-layout mb-9" data-aos="fade-up" data-aos-delay="90">
      <figure class="process-photo">
        <Image
          src={atelierPhoto}
          alt={locale === 'fr' ? 'Contrôle d’une pièce en atelier avec une tablette en réalité augmentée' : 'Checking a part on the shop floor with an augmented-reality tablet'}
          width={720}
          loading="lazy"
          class="process-photo__img"
        />
      </figure>
      <ul class="process-grid">
        {solutions.map((solution) => (
          <li class="process-item">
            <Image src={solution.icon} alt="" width={96} height={96} class="process-item__icon" aria-hidden="true" />
            <span class="process-item__label">{solution.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="text-center" data-aos="fade-up" data-aos-delay="150">
      <a href="#contact" class="process-cta">
        <span class="process-cta__text">{t('process.cta')}</span>
        <svg class="process-cta__arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .process-section {
    position: relative;
    overflow: hidden;
  }

  .process-section--gradient {
    background: var(--color-light);
  }

  /* Photo d'atelier + liste à filets fins, icônes au trait sans tuile */
  .process-layout {
    display: grid;
    gap: 1.5rem;
    align-items: stretch;
  }

  .process-photo {
    margin: 0;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    min-height: 16rem;
  }

  .process-photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    background: #ffffff;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .process-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.1rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .process-item__icon {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    flex-shrink: 0;
  }

  .process-item__label {
    color: var(--color-dark);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
  }

  @media (min-width: 640px) {
    .process-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .process-layout {
      grid-template-columns: 0.85fr 1.15fr;
    }

    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .process-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.68rem 1.25rem;
    font-size: 0.96rem;
    font-weight: 500;
    color: var(--color-primary);
    border-bottom: 1px solid currentColor;
    padding-left: 0;
    padding-right: 0;
    border-radius: 0;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .process-cta:hover {
    color: var(--color-primary-dark);
  }

  .process-cta__text {
    white-space: nowrap;
  }

  .process-cta__arrow {
    flex-shrink: 0;
    opacity: 0.7;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .process-cta:hover .process-cta__arrow {
    opacity: 1;
    transform: translateX(2px);
  }

  @media (max-width: 520px) {
    .process-item {
      padding: 0.9rem 0.85rem;
    }

    .process-item__label {
      font-size: 0.98rem;
    }

    .process-cta {
      font-size: 0.84rem;
      padding: 0.62rem 0;
      gap: 0.42rem;
    }
  }
</style>
