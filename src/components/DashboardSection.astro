---
import { useTranslations } from '../i18n/ui';
import type { Locale } from '../i18n/languages';
import { Image } from 'astro:assets';
import deskPhoto from '../assets/photos/bureau-logiciel-3d.jpg';

const locale = (Astro.currentLocale ?? 'fr') as Locale;
const t = useTranslations(locale);
---

<section class="section-soft section-spacing section-anchor-line">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Text content -->
      <div data-aos="fade-right" data-aos-duration="400">
        <span class="badge badge-accent mb-6">{t('dashboard.badge')}</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-dark mb-6 leading-tight">
          {t('dashboard.heading.prefix')}<span class="text-gradient">{t('dashboard.heading.highlight')}</span>
        </h2>
        <p class="text-text-light text-lg leading-relaxed mb-8">
          {t('dashboard.description')}
        </p>

        <div class="space-y-4">
          <div class="border-l-2 border-primary/30 pl-4">
            <div>
              <div class="text-dark font-medium text-sm">{t('dashboard.feature1.title')}</div>
              <div class="text-text-light text-sm">{t('dashboard.feature1.desc')}</div>
            </div>
          </div>

          <div class="border-l-2 border-primary/30 pl-4">
            <div>
              <div class="text-dark font-medium text-sm">{t('dashboard.feature2.title')}</div>
              <div class="text-text-light text-sm">{t('dashboard.feature2.desc')}</div>
            </div>
          </div>

          <div class="border-l-2 border-primary/30 pl-4">
            <div>
              <div class="text-dark font-medium text-sm">{t('dashboard.feature3.title')}</div>
              <div class="text-text-light text-sm">{t('dashboard.feature3.desc')}</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: capture réelle du logiciel (remplace l'ancienne maquette aux chiffres fictifs) -->
      <figure class="m-0" data-aos="fade-left" data-aos-duration="400" data-aos-delay="100">
        <div class="rounded-xl overflow-hidden border border-border shadow-xl shadow-dark/10">
          <Image
            src={deskPhoto}
            alt={locale === 'fr' ? 'Structure métallique en 3D et suivi de production dans Steel Manager' : 'Steel structure in 3D and production tracking in Steel Manager'}
            width={960}
            loading="lazy"
            class="w-full h-auto block"
          />
        </div>
        <figcaption class="mt-3 text-sm text-text-light">
          {locale === 'fr' ? 'Steel Manager : du modèle 3D au suivi de fabrication.' : 'Steel Manager: from the 3D model to production tracking.'}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
