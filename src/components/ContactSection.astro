---
import { useTranslations, getContactBenefits } from '../i18n/ui';
import type { Locale } from '../i18n/languages';
import { Image } from 'astro:assets';
import officePhoto from '../assets/photos/bureaux-herstal.jpg';

const locale = (Astro.currentLocale ?? 'fr') as Locale;
const t = useTranslations(locale);
const benefits = getContactBenefits(locale);
const emailSubject = encodeURIComponent(t('contact.emailSubject'));
---

<section id="contact" class="section-soft section-spacing section-anchor-line">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <!-- Left: Content -->
      <div data-aos="fade-right" data-aos-duration="400">
        <span class="badge badge-primary mb-6">{t('contact.badge')}</span>
        <h2 class="text-4xl sm:text-5xl font-bold text-dark mb-6 leading-tight">
          {t('contact.heading')}
        </h2>
        <p class="text-text-light text-lg leading-relaxed mb-8">
          {t('contact.description')}
        </p>

        <!-- Contact info -->
        <div class="space-y-3 mb-8">
          <a
            href="mailto:contact@devteix.com"
            class="flex items-center gap-4 p-4 bg-white border border-border rounded-lg hover:border-primary/30 hover:shadow-sm transition-all group"
          >            <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>

            <div>
              <div class="text-sm text-text-light">{t('contact.email.label')}</div>
              <div class="text-dark font-medium">contact@devteix.com</div>
            </div>
          </a>

          <a
            href="tel:+32487419120"
            class="flex items-center gap-4 p-4 bg-white border border-border rounded-lg hover:border-primary/30 hover:shadow-sm transition-all group"
          >            <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>

            <div>
              <div class="text-sm text-text-light">{t('contact.phone.label')}</div>
              <div class="text-dark font-medium">+32 487 41 91 20</div>
            </div>
          </a>

          <a
            href="https://www.google.com/maps/search/?api=1&query=Rue+d'Abhooz+27,+4040+Herstal,+Belgique"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-4 bg-white border border-border rounded-lg hover:border-primary/30 hover:shadow-sm transition-all group"
          >            <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" /></svg>

            <div class="min-w-0">
              <div class="text-sm text-text-light">{t('contact.address.label')}</div>
              <div class="text-dark font-medium text-sm sm:text-base leading-snug">{t('contact.address.value')}</div>
            </div>
          </a>
        </div>

        <!-- LinkedIn -->
        <div class="flex items-center gap-3">
          <a
            href="https://www.linkedin.com/company/steel-manager"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-lg bg-[#0A66C2] flex items-center justify-center hover:scale-105 transition-transform text-white"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <span class="text-text-light text-sm">{t('contact.linkedin')}</span>
        </div>
      </div>

      <!-- Right: CTA Card -->
      <div data-aos="fade-left" data-aos-duration="400" data-aos-delay="100">
        <div class="bg-dark rounded-xl overflow-hidden">
          <Image
            src={officePhoto}
            alt={locale === 'fr' ? 'Vue aérienne des bureaux DevTeix à Herstal' : 'Aerial view of the DevTeix offices in Herstal'}
            width={720}
            loading="lazy"
            class="w-full h-44 object-cover block"
            style="height: 11rem;"
          />
          <div class="p-8 lg:p-10">

          <h3 class="text-2xl font-bold text-white mb-3">
            {t('contact.cta.heading')}
          </h3>
          <p class="text-white/60 leading-relaxed mb-6">
            {t('contact.cta.description')}
          </p>

          <ul class="space-y-3 mb-8">
            {benefits.map((benefit) => (
              <li class="flex items-center gap-3 text-white/80 text-sm">
                <span class="w-3 h-px bg-accent flex-shrink-0" aria-hidden="true"></span>
                {benefit}
              </li>
            ))}
          </ul>

          <a
            href={`mailto:contact@devteix.com?subject=${emailSubject}`}
            class="btn btn-accent w-full justify-center"
          >
            {t('contact.cta.button')}
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
