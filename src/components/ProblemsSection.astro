---
import { useTranslations, getProblemsData } from '../i18n/ui';
import type { Locale } from '../i18n/languages';
import { Image } from 'astro:assets';
import desktopSteelManager from '../assets/devices/desktop-steel-manager.png';
import mobileApp from '../assets/devices/mobile-app.png';
import tabletAr from '../assets/devices/tablet-ar.png';
import laptop3d from '../assets/devices/laptop-3d.png';

const locale = (Astro.currentLocale ?? 'fr') as Locale;
const t = useTranslations(locale);
const problemsData = getProblemsData(locale);

// Chaque problème est illustré par l'outil qui y répond (captures réelles)
const visuals = [
  { src: desktopSteelManager, alt: locale === 'fr' ? 'Steel Manager sur écran de bureau' : 'Steel Manager on a desktop screen' },
  { src: mobileApp, alt: locale === 'fr' ? "Application mobile Steel Manager pour l'atelier" : 'Steel Manager shop-floor mobile app' },
  { src: tabletAr, alt: locale === 'fr' ? 'Tablette en réalité augmentée sur une pièce en atelier' : 'Augmented-reality tablet over a part on the shop floor' },
  { src: laptop3d, alt: locale === 'fr' ? 'Modèle 3D importé dans Steel Manager' : '3D model imported into Steel Manager' },
];
const problems = problemsData.map((p, i) => ({ ...p, visual: visuals[i] }));
---

<section id="solutions" class="section-dark section-spacing section-anchor-line relative overflow-hidden">

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12" data-aos="fade-up">
      <span class="badge mb-4" style="color: var(--color-accent);">
        {t('problems.badge')}
      </span>
      <h2 class="text-4xl sm:text-5xl font-bold text-white mb-4">
        {t('problems.heading')}
      </h2>
      <p class="text-white/60 text-lg">
        {t('problems.description')}
      </p>
    </div>

    <!-- Problems/Solutions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4 lg:gap-6">
      {problems.map((item, index) => (
        <article
          class="problem-card group rounded-xl overflow-hidden"
          data-aos="fade-up"
          data-aos-delay={index * 50}
        >
          <div class="problem-visual">
            <Image
              src={item.visual.src}
              alt={item.visual.alt}
              width={420}
              loading="lazy"
              class="problem-visual__img"
            />
          </div>

          <div class="p-5 sm:p-6 lg:p-7">
            <p class="problem-title text-white font-semibold text-xl sm:text-[1.6rem] leading-snug mb-3">
              "{item.problem}"
            </p>

            <!-- Solution -->
            <p class="text-white/65 text-sm leading-relaxed mb-3">
              {item.solution}
            </p>

            <!-- Detail/Proof -->
            <p class="text-xs text-accent font-medium">
              {item.detail}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom note -->
    <div class="text-center mt-10" data-aos="fade-up">
      <p class="text-white/40 text-sm">
        {t('problems.bottomNote')}
        <a href="#contact" class="text-accent font-medium hover:text-accent/80 transition-colors ml-1">
          {t('problems.bottomCta')} &rarr;
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .problem-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    min-height: 100%;
    transition: border-color 200ms ease;
  }

  .problem-card:hover {
    border-color: rgba(255, 255, 255, 0.18);
  }

  /* Bandeau visuel : l'appareil repose en bas du cadre */
  .problem-visual {
    height: 13.5rem;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1.5rem 1.5rem 0;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .problem-visual__img {
    max-height: 100%;
    width: auto;
    object-fit: contain;
    transition: transform 300ms ease;
  }

  .problem-card:hover .problem-visual__img {
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .problem-card,
    .problem-visual__img {
      transition: none;
    }
  }

  @media (max-width: 767px) {
    .problem-title {
      font-size: 1.22rem;
      line-height: 1.28;
    }
  }
</style>
